# Copy to `.env` for local overrides. Never commit real secrets.
NODE_ENV=development

# --- Compose service: db (Postgres) ---
# Non-default credentials on purpose — do not use postgres/postgres.
# Generate a local password, e.g. `openssl rand -base64 24` (URL-safe: avoid
# characters that need encoding in DATABASE_URL, or percent-encode them).
POSTGRES_USER=pack
POSTGRES_PASSWORD=pack_dev_change_me
POSTGRES_DB=pack_challenge
POSTGRES_PORT=5432

# Host-machine URL (apps on the host with `docker compose up -d db`).
# Keep POSTGRES_PASSWORD and the password segment of DATABASE_URL in sync.
# Compose service `app` overrides this to use hostname `db` instead of localhost.
DATABASE_URL=postgresql://pack:pack_dev_change_me@localhost:5432/pack_challenge

# --- Compose service: app (SvelteKit) ---
APP_PORT=3000
# Absolute or repo-relative directory for uploaded objects (outside web static).
# Compose overrides this to /data/file-store inside the app container.
FILE_STORAGE_ROOT=var/file-store
