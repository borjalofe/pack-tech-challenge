{
	"name": "pack-tech-challenge",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"audit": "pnpm audit --audit-level=high",
		"db:migrate": "tsx src/lib/server/db/migrate.ts",
		"db:seed": "tsx src/lib/server/db/seed.ts",
		"db:seed:demo": "tsx src/lib/server/db/seed-demo-cli.ts",
		"start": "NODE_ENV=production node build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"dotenv": "^18.0.9",
		"drizzle-orm": "^0.45.4",
		"postgres": "^4.1.0",
		"tsx": "^4.23.15",
		"zod": "^4.6.7"
	}
}
